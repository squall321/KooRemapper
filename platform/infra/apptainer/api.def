Bootstrap: docker
From: python:3.12-slim

%labels
    Component  koorm-api
    Version    0.1.0

%files
    # 재빌드가 기존 패키지 판을 올리지 않도록 현재 이미지 판을 고정한다(recipes-1026 §2).
    api-constraints.txt /api-constraints.txt

%post
    set -eux
    apt-get update
    apt-get install -y --no-install-recommends build-essential libpq-dev curl
    # gmsh (meshfix) runtime shared libraries — gmsh is GL-linked even headless.
    apt-get install -y --no-install-recommends \
        libglu1-mesa libgl1 libxrender1 libxcursor1 libxfixes3 libxext6 \
        libxft2 libfontconfig1 libxinerama1 libx11-6
    rm -rf /var/lib/apt/lists/*
    pip install --upgrade pip
    # Baseline tooling baked in; app source comes from the bind-mounted /workspace.
    # numpy·scipy 는 레시피 샌드박스가 쓰는 수치 라이브러리다. -c 로 나머지 판을 고정해,
    # 이것을 더하려고 다시 구울 때 fastapi·pydantic 같은 것이 조용히 올라가지 않게 한다.
    pip install --no-cache-dir -c /api-constraints.txt \
        "fastapi>=0.115" "uvicorn[standard]>=0.32" \
        "sqlalchemy[asyncio]>=2.0.36" "alembic>=1.14" "asyncpg>=0.30" \
        "pydantic>=2.9" "email-validator>=2.2" "pydantic-settings>=2.6" \
        "python-jose[cryptography]>=3.3" "argon2-cffi>=23.1" "python-multipart>=0.0.18" \
        "ulid-py>=1.1" "PyYAML>=6.0" "jsonschema>=4.23" "httpx>=0.28" \
        "numpy" "scipy"

%environment
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/workspace/platform/backend
    # gmsh (for meshfix) is not baked into the image. It lives in the bind-mounted
    # repo at dist/gmsh and is linked next to the binary by setup-gmsh.sh (run from
    # start.sh); KooRemapper's findGmshExe discovers it at bin/gmsh/gmsh.exe.

%runscript
    PORT="${KOORM_API_PORT:-8700}"
    cd /workspace/platform/backend
    # --no-proxy-headers: do NOT let uvicorn rewrite request.client from the
    # spoofable X-Forwarded-For. The app's rate limiter (app/shared/ratelimit.py)
    # is the single authority: it trusts XFF only from the loopback proxy peer and
    # uses the nginx-appended last hop. Letting uvicorn rewrite client first would
    # reintroduce an XFF-spoof rate-limit bypass.
    exec uvicorn app.main:app --host 0.0.0.0 --port "$PORT" --no-proxy-headers \
        --timeout-graceful-shutdown 5 "$@"

%startscript
    # No --reload: the bind-mounted source generates .pyc churn under app/ when
    # other processes import the package, which would trip the reloader and bounce
    # the server. Apply code changes with: infra/scripts/restart.sh
    PORT="${KOORM_API_PORT:-8700}"
    cd /workspace/platform/backend
    # --no-proxy-headers: see %runscript — the rate limiter owns XFF handling.
    exec uvicorn app.main:app --host 0.0.0.0 --port "$PORT" --no-proxy-headers \
        --timeout-graceful-shutdown 5

%help
    KooRemapper Platform API container.
    Build: apptainer build platform/infra/apptainer/api.sif platform/infra/apptainer/api.def
