# KooRemapper Platform — environment (copy to platform/.env and edit)
# Apptainer scripts and the FastAPI backend both read these.

# ── PostgreSQL (Apptainer instance, local) ──────────────────────────
POSTGRES_USER=koorm
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_DB=koorm
POSTGRES_PORT=5433

# ── Backend (FastAPI) ───────────────────────────────────────────────
KOORM_APP_ENV=development
KOORM_API_PORT=8700
KOORM_DATABASE_URL=postgresql+asyncpg://koorm:CHANGE_ME_postgres@127.0.0.1:5433/koorm
KOORM_JWT_SECRET=CHANGE_ME_jwt_secret
KOORM_CORS_ORIGINS=http://localhost:5273,http://127.0.0.1:5273
KOORM_WORKER_CONCURRENCY=4
KOORM_JOB_TIMEOUT_SEC=1800

# ── MCP server ──────────────────────────────────────────────────────
KOORM_MCP_PORT=8701
# REST base the MCP server forwards to (this backend)
KOOREMAPPER_API_BASE=http://127.0.0.1:8700
# Comma-separated allowed Host headers when binding non-localhost (DNS-rebind guard).
# Leave empty for localhost-only / behind nginx.
MCP_ALLOWED_HOSTS=

# ── Frontend (web instance) ─────────────────────────────────────────
WEB_PORT=5273

# ── Apptainer ───────────────────────────────────────────────────────
# Force explicit host network on instances when default net = bridge.
KOORM_APPT_HOST_NET=0

# ── Seed admin (used by seed.sh) ────────────────────────────────────
KOORM_ADMIN_EMAIL=admin@kooremapper.local
KOORM_ADMIN_PASSWORD=admin
