# KooRemapper Platform — environment (copy to platform/.env and edit)
# Apptainer scripts and the FastAPI backend both read these.

# ── PostgreSQL (Apptainer instance, local) ──────────────────────────
POSTGRES_USER=koorm
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_DB=koorm
POSTGRES_PORT=5433

# ── Backend (FastAPI) ───────────────────────────────────────────────
KOORM_APP_ENV=development
KOORM_API_PORT=8700
KOORM_DATABASE_URL=postgresql+asyncpg://koorm:CHANGE_ME_postgres@127.0.0.1:5433/koorm
KOORM_JWT_SECRET=CHANGE_ME_jwt_secret
KOORM_CORS_ORIGINS=http://localhost:5273,http://127.0.0.1:5273
KOORM_WORKER_CONCURRENCY=4
KOORM_JOB_TIMEOUT_SEC=1800
# HEAX Portal 게이트웨이 SSO — HEAXHub backend/.env 의 GATEWAY_SHARED_SECRET 와
# 동일 값. 설정 시 포탈 프록시 경유 요청이 kr_ PAT 로 자동 로그인. 비우면 /auth/sso 비활성.
KOORM_HEAX_GATEWAY_SECRET=

# ── MCP server ──────────────────────────────────────────────────────
KOORM_MCP_PORT=8701
# REST base the MCP server forwards to (this backend)
KOOREMAPPER_API_BASE=http://127.0.0.1:8700
# Comma-separated allowed Host headers when binding non-localhost (DNS-rebind guard).
# Leave empty for localhost-only / behind nginx.
MCP_ALLOWED_HOSTS=

# ── Frontend (web instance) ─────────────────────────────────────────
WEB_PORT=5273

# ── Apptainer ───────────────────────────────────────────────────────
# Force explicit host network on instances when default net = bridge.
KOORM_APPT_HOST_NET=0

# ── Drive 아티팩트 미러 (HWAXPortal update-all 배포용) ────────────────
# dev 가 dist-to-drive.sh 로 바이너리+dist+cli.sif 를 올리고, prod 가 dist-from-drive.sh 로 받는다.
# HEAXHub 등 다른 서비스와 같은 rclone remote alias 사용. 미설정 시 Drive 배포 경로 비활성.
KOORM_DRIVE_REMOTE=
KOORM_DRIVE_RETAIN=3

# ── Seed admin (used by seed.sh) ────────────────────────────────────
KOORM_ADMIN_EMAIL=admin@kooremapper.local
KOORM_ADMIN_PASSWORD=admin

# ── AI Data Hub (리포트 등재, publish-datahub) ──────────────────────
# 대상 허브 URL. 비우면 등재 비활성(400). 기본은 호스트넷 공유 인스턴스.
KOORM_DATAHUB_URL=http://127.0.0.1:8001

# ── ReportArchive pull 연동 (/api/v1/analysis/*) ────────────────────
# 목록 응답 file_url 에 쓸 외부 base URL. 비우면 요청의 base_url 을 쓴다.
# 포탈 서브패스(/apps/kooremapper) 뒤라 내부 base 와 다르면 외부 URL 을 넣는다.
KOORM_ANALYSIS_PUBLIC_BASE_URL=
# 이 DynaForge 인스턴스 식별자(여러 DynaForge → 하나의 ReportArchive 집계 시 출처 표시).
# 예: dynaforge-cae00. run_key(ULID)는 전역 유일이라 dedup 엔 안 쓰이고 표시·그룹핑용.
KOORM_ANALYSIS_SITE_ID=

# ── nginx TLS reverse proxy (optional) ──────────────────────────────
# Set to 1 to start an nginx instance terminating TLS and proxying /api + /mcp.
KOORM_ENABLE_NGINX=0
KOORM_HTTPS_PORT=8443
KOORM_HTTP_PORT=8089
# Self-signed cert CN (gen-certs.sh). Set to your host/domain to avoid warnings.
CERT_CN=kooremapper.local
