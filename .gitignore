# Build directories
build/
cmake-build-*/
out/

# IDE files
.vs/
.vscode/
.idea/
*.user
*.suo
*.sln.docstates

# Compiled files
*.obj
*.o
*.a
*.lib
*.exe
*.dll
*.so
*.dylib
*.zip

# Test output
*.k.bak
*_test.k
test_error.k
# quadratic 예제 입력 — 위 규칙에 걸려 한 번도 커밋되지 않아 예제가 실행되지 않았다
!examples/quadratic/shell_test.k
!examples/quadratic/tet_test.k
# examples/assemble_display/gen_al_box.yaml 산출(약 120MB) — GitHub 파일 100MB 제한, 필요하면 YAML 로 다시 만든다
examples/assemble_display/al_box.k

# Temporary files
*.tmp
*.temp
*.log
nul

# OS files
.DS_Store
Thumbs.db

# NVIDIA logs
NVIDIA Corporation/


# Python
venv/
__pycache__/
*.pyc

# Presentations
*.pptx

# 벤더 gmsh 바이너리(87MB) — 커밋하지 않지만 지우면 안 된다.
# platform/infra/apptainer/cli.def 가 %files 로 굽고 setup-gmsh.sh 가 여기로 심링크를 건다.
dist/gmsh/

# Large test files (>50MB)
test_data/million_*.k
test_data/large_*.k
!test_data/large_flat.yaml

# ============================================================
# Platform (FastAPI backend + MCP + frontend + Apptainer) — runtime artifacts
# Source under platform/ is tracked; the following are generated/local only.
# ============================================================
# CMake POST_BUILD copies the binary + materials here
platform/backend/bin/
# uploaded/generated session files
platform/storage/
# stray binary copies (gmsh etc.)
platform/backend/dist/
# postgres data dir (bind-mount)
platform/infra/data/
# built container images
platform/infra/apptainer/*.sif
# local secrets
platform/**/.env
# self-signed TLS material (generated by infra/scripts/gen-certs.sh)
platform/infra/nginx/certs/
platform/backend/.venv/
platform/mcp_server/venv/
platform/frontend/node_modules/
platform/frontend/dist/
# python bytecode (anywhere under platform)
__pycache__/
*.pyc

# Playwright MCP artifacts
.playwright-mcp/
platform/frontend/.playwright-mcp/
koorm-*.png
*.tsbuildinfo

# /data 이관 브리지(심링크) 이름 — dir/ 패턴은 심링크를 무시하지 않아 git stash -u 가 치운다(data-migration D0)
platform/infra/data
platform/storage

# data-migrate 가 남기는 옛 경로 원본(유예 뒤 사람이 지운다). 미추적이면 deploy-all 의 git stash -u 가 치운다
*.pre-move-*
